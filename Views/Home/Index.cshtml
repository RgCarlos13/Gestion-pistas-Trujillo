@{
    ViewData["Title"] = "Inicio - Gestión de Pistas";
}

<div class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">Sistema de Gestión de Pistas Urbanas</h1>
        <p class="hero-subtitle">Trujillo - Perú</p>
        <p class="hero-description">
            Plataforma piloto para registrar, consultar y dar seguimiento al estado de las pistas
            dentro del Centro Histórico de Trujillo, tomando como referencia el anillo de la Av. España.
        </p>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="card-icon">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#0d6efd" stroke-width="1.5">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                        <path d="M2 17l10 5 10-5"/>
                        <path d="M2 12l10 5 10-5"/>
                    </svg>
                </div>
                <h5 class="card-title mt-3">Registrar Tramo</h5>
                <p class="card-text">Reporta el estado de una pista dentro del Centro Histórico. El mapa solo permite marcar dentro del área piloto.</p>
                <a asp-controller="Tramos" asp-action="Crear" class="btn btn-primary">Registrar ahora</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="card-icon">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#198754" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <line x1="3" y1="9" x2="21" y2="9"/>
                        <line x1="9" y1="21" x2="9" y2="9"/>
                    </svg>
                </div>
                <h5 class="card-title mt-3">Ver Tramos</h5>
                <p class="card-text">Consulta los tramos registrados en el Centro Histórico y filtra por estado de la pista.</p>
                <a asp-controller="Tramos" asp-action="Index" class="btn btn-success">Ver listado</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="card-icon">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#ffc107" stroke-width="1.5">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                    </svg>
                </div>
                <h5 class="card-title mt-3">Reportes</h5>
                <p class="card-text">Consulta un resumen de los registros, busca reportes por código y revisa el historial de cambios recientes.</p>
                <a asp-controller="Reportes" asp-action="Index" class="btn btn-warning text-dark">Ver reportes</a>
            </div>
        </div>
    </div>
</div>
