@model GestionPistasWeb.Models.Tramo
@{
    ViewData["Title"] = $"Tramo #{Model.Id} - Detalle";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Detalle del Tramo #@Model.Id</h1>
        <p class="text-muted mb-0">Reporte vial registrado dentro del Centro Histórico de Trujillo.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">Volver a lista</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Ubicación del tramo</h5>
                <span class="badge estado-@Model.Estado.ToString().ToLower() fs-6">@Model.Estado</span>
            </div>
            <div class="card-body">
                @if (Model.TieneCoordenadas)
                {
                    <div id="mapaDetalle" class="mapa-trujillo mapa-detalle"></div>
                    <div class="row small text-muted mt-3">
                        <div class="col-md-6"><strong>Inicio:</strong> @Model.LatInicio.ToString("F6"), @Model.LngInicio.ToString("F6")</div>
                        <div class="col-md-6"><strong>Fin:</strong> @Model.LatFin.ToString("F6"), @Model.LngFin.ToString("F6")</div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">Este registro no tiene coordenadas guardadas.</div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Información del Tramo</h5>
                <span class="badge estado-@Model.Estado.ToString().ToLower() fs-6">@Model.Estado</span>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6"><strong>Zona de trabajo:</strong> Centro Histórico de Trujillo</div>
                    <div class="col-md-6"><strong>Sector:</strong> @Model.Zona</div>
                </div>
                <div class="mb-3"><strong>Dirección:</strong> @Model.DireccionReferencia</div>
                <div class="row mb-3">
                    <div class="col-md-6"><strong>Tipo de Vía:</strong> @Model.TipoVia</div>
                    <div class="col-md-6">
                        <strong>Activo:</strong>
                        @if (Model.Activo)
                        {
                            <span class="text-success">Sí</span>
                        }
                        else
                        {
                            <span class="text-danger">No</span>
                        }
                    </div>
                </div>
                <div class="mb-3">
                    <strong>Descripción:</strong>
                    <p class="mt-1">@Model.Descripcion</p>
                </div>
                <div class="row">
                    <div class="col-md-6"><strong>Reportado por:</strong> @Model.ReportadoPor</div>
                    <div class="col-md-3"><strong>Registrado:</strong> @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="col-md-3"><strong>Actualizado:</strong> @Model.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Cambiar Estado</h5></div>
            <div class="card-body">
                <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post" class="row g-2">
                    <div class="col-md-8">
                        <select name="nuevoEstado" class="form-select">
                            <option value="Bueno" selected='@(Model.Estado == EstadoTramo.Bueno ? "selected" : null)'>Bueno</option>
                            <option value="Regular" selected='@(Model.Estado == EstadoTramo.Regular ? "selected" : null)'>Regular</option>
                            <option value="Malo" selected='@(Model.Estado == EstadoTramo.Malo ? "selected" : null)'>Malo</option>
                            <option value="EnReparacion" selected='@(Model.Estado == EstadoTramo.EnReparacion ? "selected" : null)'>En reparación</option>
                            <option value="Intransitable" selected='@(Model.Estado == EstadoTramo.Intransitable ? "selected" : null)'>Intransitable</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-warning w-100">Actualizar Estado</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Evidencia</h5></div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.RutaEvidencia))
                {
                    <img src="@Model.RutaEvidencia" class="img-fluid rounded evidencia-detalle" alt="Evidencia del tramo #@Model.Id" />
                    <p class="small text-muted mt-2 mb-0">Archivo original: @Model.NombreEvidencia</p>
                }
                else
                {
                    <p class="text-muted mb-0">No hay evidencia disponible para este tramo.</p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Historial de Cambios</h5></div>
            <div class="card-body">
                @{ var cambios = Model.HistorialCambios.RecorrerAtras(); }
                @if (cambios.Contar() == 0)
                {
                    <p class="text-muted">Sin cambios registrados.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @{
                            var nodoCambio = cambios.ObtenerCabeza();
                            while (nodoCambio != null)
                            {
                                <li class="list-group-item py-1 small">@nodoCambio.Data</li>
                                nodoCambio = nodoCambio.Siguiente;
                            }
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/mapa-trujillo.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tramoLista = @Html.Raw(ViewBag.TramoMapaJson ?? "null");
            const tramo = tramoLista.length > 0 ? tramoLista[0] : null;
            if (tramo) TrujilloVialMapa.initDetalle('mapaDetalle', tramo);
        });
    </script>
}
